    "GNT-ASYNC-SUP-001"
   ]
  },
  {
   "id": "decision-04",
   "status": "resolved",
   "resolution": "Executor completion preserves integration-panic and Gantry-invariant origins, while executor-internal failures remain a distinct failed result.",
   "normative_requirements": [
    "GNT-15.4-owned-work",
    "GNT-15.9-boundary-failure-containment"
   ],
   "generated_artifacts": [
