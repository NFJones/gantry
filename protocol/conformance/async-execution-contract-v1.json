        "GNT-ASYNC-CONF-001"
      ]
    },
    {
      "id": "decision-10",
      "status": "resolved",
      "resolution": "Every interpreter-owned async activity is registered through the same bounded supervision and lifecycle accounting used by execution tasks; shutdown waits for each owned class.",
      "normative_requirements": [
        "GNT-10.13",
        "GNT-15.1-automatic-execution",
        "GNT-15.4-owned-work"
