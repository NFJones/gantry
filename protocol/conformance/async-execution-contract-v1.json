    {
      "id": "decision-13",
      "status": "resolved",
      "resolution": "Accepted state and supervision registration precede source progress; a root may complete before caller observation, and no post-return activation handshake or manual driver remains.",
      "normative_requirements": [
        "GNT-15.1-automatic-execution",
        "GNT-3-M-LIFECYCLES"
      ],
      "generated_artifacts": [
