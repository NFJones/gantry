 "decisions": [
  {
   "id": "decision-01",
   "status": "resolved",
   "resolution": "Every evaluator receives owned task submission, completion observation, and abort through the executor adapter; Gantry owns semantic tasks while the embedding owns the runtime.",
   "normative_requirements": [
    "GNT-15.4",
    "GNT-3.3-runtime-ownership"
