    {
      "id": "decision-11",
      "status": "resolved",
      "resolution": "The cloneable public facade tracks external owners separately from internal task references and runs the nonblocking unclean-drop path exactly once for the last external owner.",
      "normative_requirements": [
        "GNT-10.13",
        "GNT-15.1-automatic-execution"
      ],
