      ]
    },
    {
      "id": "decision-06",
      "status": "resolved",
      "resolution": "Package snapshot, parsing, and analysis work uses a bounded BlockingWorkService or equivalent provider-owned worker with nonblocking queue admission and owned immutable inputs.",
      "normative_requirements": [
        "GNT-15.4-owned-work",
        "GNT-15.7"
      ],
      "generated_artifacts": [
        "crates/gantry-core/src/generated/portable.rs",
