   ]
  },
  {
   "id": "decision-02",
   "status": "resolved",
   "resolution": "OwnedTaskResult remains an opaque transport acknowledgement and never carries a Gantry source value or semantic task status.",
   "normative_requirements": [
    "GNT-15.4-owned-work"
   ],
   "generated_artifacts": [
