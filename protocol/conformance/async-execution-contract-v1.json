      ]
    },
    {
      "id": "decision-05",
      "status": "resolved",
      "resolution": "Post-acceptance establishment belongs to a Send and Sync RuntimeSessionService; pre-acceptance mapping and session resolution remain must-settle IntegrationPreflight operations.",
      "normative_requirements": [
        "GNT-15.1-automatic-execution",
        "GNT-15.2-runtime-sessions",
        "GNT-15.9"
      ],
      "generated_artifacts": [
