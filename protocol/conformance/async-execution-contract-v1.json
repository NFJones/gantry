      ]
    },
    {
      "id": "decision-09",
      "status": "resolved",
      "resolution": "Cross-execution roots, children, resume sets, public activities, background tasks, blocking jobs, and event deliveries use separate finite capacities with one acyclic acquisition order.",
      "normative_requirements": [
        "GNT-15.4-owned-work",
        "GNT-15.7"
      ],
      "generated_artifacts": [
        "crates/gantry-core/src/generated/portable.rs",
