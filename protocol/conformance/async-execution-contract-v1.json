  "decisions": [
    {
      "id": "decision-01",
      "status": "resolved",
      "resolution": "Every evaluator receives owned task submission, completion observation, and abort through the executor adapter; Gantry owns semantic tasks while the embedding owns the runtime.",
      "normative_requirements": [
        "GNT-15.4",
        "GNT-3.3-runtime-ownership"
      ],
      "generated_artifacts": [
        "crates/gantry-host/src/generated/embedding.rs",
        "protocol/catalogs/embedding-contracts-v1.json"
      ],
      "implementation_owners": [
        "GNT-ASYNC-EXEC-001"
      ]
    },
    {
      "id": "decision-02",
      "status": "resolved",
      "resolution": "OwnedTaskResult remains an opaque transport acknowledgement and never carries a Gantry source value or semantic task status.",
      "normative_requirements": [
        "GNT-15.4-owned-work"
      ],
      "generated_artifacts": [
        "crates/gantry-host/src/generated/embedding.rs",
        "protocol/catalogs/embedding-contracts-v1.json"
      ],
      "implementation_owners": [
        "GNT-ASYNC-EXEC-001",
        "GNT-ASYNC-SUP-001"
      ]
    },
    {
      "id": "decision-03",
      "status": "resolved",
      "resolution": "Completion observation distinguishes completed, stopped, panicked, and failed; registered completion ownership must be bounded and non-recursive.",
      "normative_requirements": [
        "GNT-15.4-owned-work"
      ],
      "generated_artifacts": [
        "crates/gantry-host/src/generated/embedding.rs",
        "protocol/catalogs/embedding-contracts-v1.json"
      ],
      "implementation_owners": [
        "GNT-ASYNC-EXEC-001",
        "GNT-ASYNC-SUP-001"
      ]
    },
    {
      "id": "decision-04",
      "status": "resolved",
      "resolution": "Executor completion preserves integration-panic and Gantry-invariant origins, while executor-internal failures remain a distinct failed result.",
      "normative_requirements": [
        "GNT-15.4-owned-work",
        "GNT-15.9-boundary-failure-containment"
      ],
      "generated_artifacts": [
        "crates/gantry-host/src/generated/embedding.rs",
        "protocol/catalogs/embedding-contracts-v1.json"
      ],
      "implementation_owners": [
