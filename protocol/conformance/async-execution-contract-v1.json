    {
      "id": "decision-12",
      "status": "resolved",
      "resolution": "A reserved control-plane capacity remains unavailable to ordinary work so failure settlement, reaping, rollback, cancellation, owner release, and shutdown retain bounded progress under saturation.",
      "normative_requirements": [
        "GNT-15.4-owned-work",
        "GNT-15.7"
      ],
      "generated_artifacts": [
        "crates/gantry-core/src/generated/portable.rs",
