    "GNT-ASYNC-SUP-001"
   ]
  },
  {
   "id": "decision-03",
   "status": "resolved",
   "resolution": "Completion observation distinguishes completed, stopped, panicked, and failed; registered completion ownership must be bounded and non-recursive.",
   "normative_requirements": [
    "GNT-15.4-owned-work"
   ],
   "generated_artifacts": [
    "crates/gantry-host/src/generated/embedding.rs",
    "protocol/catalogs/embedding-contracts-v1.json"
   ],
   "implementation_owners": [
