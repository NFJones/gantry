{
  "format": "gantry.journal-storage-vectors/v1",
  "first_sequence": 1,
  "prefix_forms": [
    "full-prefix",
    "snapshot-prefix"
  ],
  "contract_cases": [
    "atomic-commit",
    "batch-local-cycle-rejection",
    "batch-local-reference-resolution",
    "concurrent-commit-linearization",
    "contiguous-receipts",
    "fenced-owner-exclusion",
    "idempotent-protected-payload",
    "owner-release-nonmutation",
    "protected-payload-conflict",
    "snapshot-prefix-validation",
    "stale-owner-rejection",
    "watermark-prefix-read"
  ],
  "error_codes": [
    "identity-failure",
    "internal",
    "invalid-batch",
    "missing-evidence",
    "missing-payload",
    "ownership-unavailable",
    "payload-conflict",
    "sequence-exhausted",
    "stale-ownership"
  ],
  "in_memory_persistence_claim": "none"
}
