{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gantry.invalid/protocol/concurrent-lifecycle/v1/schema.json",
  "title": "Gantry concurrent-lifecycle conformance vectors v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": { "const": "gantry.concurrent-lifecycle-vectors/v1" },
    "task_statuses": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "abort_results": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["already-settled", "failed", "stopped"] }
    },
    "terminal_categories": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "event_kinds": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "cases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "required": [
    "format",
    "task_statuses",
    "abort_results",
    "terminal_categories",
    "event_kinds",
    "cases"
  ]
}
