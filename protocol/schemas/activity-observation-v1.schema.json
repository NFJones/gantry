{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gantry.invalid/protocol/activity-observation/v1/schema.json",
  "title": "Gantry nondurable activity observation vectors v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": { "const": "gantry.activity-observation-vectors/v1" },
    "event_completion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "parse" },
        "layer": { "const": "physical" },
        "activity_material": { "$ref": "#/$defs/material" },
        "event_material": { "$ref": "#/$defs/material" },
        "timestamp": { "$ref": "#/$defs/timestamp" }
      },
      "required": ["kind", "layer", "activity_material", "event_material", "timestamp"]
    },
    "projection_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "class": {
            "enum": [
              "integration-diagnostic",
              "normalized-decision",
              "normalized-operation-error",
              "normalized-value",
              "operation-request",
              "raw-output",
              "source-snippet"
            ]
          },
          "raw_output": { "type": "boolean" },
          "operation_request_content": { "type": "boolean" },
          "operation_result_content": { "type": "boolean" },
          "integration_diagnostics": { "type": "boolean" },
          "source_snippets": { "type": "boolean" },
          "expected": { "enum": ["available", "redacted"] }
        },
        "required": [
          "class",
          "raw_output",
          "operation_request_content",
          "operation_result_content",
          "integration_diagnostics",
          "source_snippets",
          "expected"
        ]
      }
    },
    "retry_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "initial_delay_us": { "$ref": "#/$defs/portableInteger" },
          "cap_us": { "$ref": "#/$defs/portableInteger" },
          "retry_number": { "type": "integer", "minimum": 1 },
          "expected_ceiling_us": { "$ref": "#/$defs/portableInteger" }
        },
        "required": ["initial_delay_us", "cap_us", "retry_number", "expected_ceiling_us"]
      }
    },
    "barrier_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "class": { "enum": ["best-effort", "required"] },
          "outcome": { "enum": ["success", "terminal"] },
          "expected_barrier": { "enum": ["delivered", "required-exhausted"] }
        },
        "required": ["class", "outcome", "expected_barrier"]
      }
    }
  },
  "required": ["format", "event_completion", "projection_cases", "retry_cases", "barrier_cases"],
  "$defs": {
    "material": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{6}Z$"
    },
    "portableInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    }
  }
}
