{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gantry.invalid/protocol/durable-recovery/v1/schema.json",
  "title": "Gantry durable-recovery conformance vectors v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": { "const": "gantry.durable-recovery-vectors/v1" },
    "checkpoint_formats": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "commit_cuts": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "operation_recovery": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "prefix_forms": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "enum": ["full-prefix", "snapshot-prefix"] }
    },
    "cases": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "required": [
    "format",
    "checkpoint_formats",
    "commit_cuts",
    "operation_recovery",
    "prefix_forms",
    "cases"
  ]
}
