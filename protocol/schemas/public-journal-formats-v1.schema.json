{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gantry.example/protocol/schemas/public-journal-formats-v1.schema.json",
  "title": "Gantry public journal, event, and recovery bodies v1",
  "oneOf": [
    { "$ref": "#/$defs/cancellation" },
    { "$ref": "#/$defs/concurrent_evidence" },
    { "$ref": "#/$defs/concurrent_evidence_v5" },
    { "$ref": "#/$defs/concurrent_recovery_snapshot" },
    { "$ref": "#/$defs/event_dispatched" },
    { "$ref": "#/$defs/event_occurrence" },
    { "$ref": "#/$defs/event_settled" },
    { "$ref": "#/$defs/execution_start" },
    { "$ref": "#/$defs/execution_state" },
    { "$ref": "#/$defs/logical_evidence" },
    { "$ref": "#/$defs/recovery_snapshot" }
  ],
  "$defs": {
    "unsigned": {
      "type": "number",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "hex": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{2})*$"
    },
    "identity": {
      "type": "string",
      "pattern": "^(?:activity|delivery-attempt|dispatch|event|evidence|execution|operation|session|task):[0-9a-f]{64}$"
    },
    "activity_identity": {
      "type": "string",
      "pattern": "^activity:[0-9a-f]{64}$"
    },
    "execution_identity": {
      "type": "string",
      "pattern": "^execution:[0-9a-f]{64}$"
    },
    "task_identity": {
      "type": "string",
      "pattern": "^task:[0-9a-f]{64}$"
    },
    "operation_identity": {
      "type": "string",
      "pattern": "^operation:[0-9a-f]{64}$"
    },
    "session_identity": {
      "type": "string",
      "pattern": "^session:[0-9a-f]{64}$"
    },
    "dispatch_identity": {
      "type": "string",
      "pattern": "^dispatch:[0-9a-f]{64}$"
    },
    "event_identity": {
      "type": "string",
      "pattern": "^event:[0-9a-f]{64}$"
    },
    "attempt_identity": {
      "type": "string",
      "pattern": "^delivery-attempt:[0-9a-f]{64}$"
    },
    "evidence_identity": {
      "type": "string",
      "pattern": "^evidence:[0-9a-f]{64}$"
    },
    "nullable_string": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1 }
      ]
    },
    "nullable_hex": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/hex" }
      ]
    },
    "nullable_unsigned": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/unsigned" }
      ]
    },
    "operation": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/operation_body" }
      ]
    },
    "operation_body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action_recovery": { "$ref": "#/$defs/nullable_string" },
        "dispatch_id": { "$ref": "#/$defs/nullable_string" },
        "operation_id": { "$ref": "#/$defs/identity" },
        "outcome": {},
        "recovery_dispatch": { "$ref": "#/$defs/unsigned" },
        "request_bytes": { "$ref": "#/$defs/nullable_hex" },
        "result_bytes": { "$ref": "#/$defs/nullable_hex" },
        "result_type": { "$ref": "#/$defs/nullable_string" },
        "retries_left": { "$ref": "#/$defs/nullable_unsigned" },
        "retry_delay_us": { "$ref": "#/$defs/nullable_unsigned" },
        "retry_errors": { "type": "array" },
        "validation_attempt": { "$ref": "#/$defs/unsigned" }
      },
      "required": [
        "action_recovery",
        "dispatch_id",
        "operation_id",
        "outcome",
        "recovery_dispatch",
        "request_bytes",
        "result_bytes",
        "result_type",
        "retries_left",
        "retry_delay_us",
        "retry_errors",
        "validation_attempt"
      ]
    },
    "action_recovery": {
      "oneOf": [
        { "type": "null" },
        { "enum": ["idempotent", "non_idempotent", "read_only"] }
      ]
    },
    "hook_outcome": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "category": { "type": "null" },
            "kind": { "const": "completed" },
            "payload": { "$ref": "#/$defs/hex" }
          },
          "required": ["category", "kind", "payload"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "category": { "type": "null" },
            "kind": { "const": "declined" },
            "payload": { "type": "string" }
          },
          "required": ["category", "kind", "payload"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "category": {
              "enum": [
                "cancelled",
                "policy-denied",
                "provider-failure",
                "timeout",
                "unknown-outcome"
              ]
            },
            "kind": { "const": "failed" },
            "payload": { "type": "string" }
          },
          "required": ["category", "kind", "payload"]
        }
      ]
    },
    "retry_error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "json-duplicate-key",
            "json-syntax",
            "json-unicode",
            "resource-limit",
            "schema",
            "utf8"
          ]
        },
        "instance_location": {
          "oneOf": [{ "type": "null" }, { "type": "string" }]
        },
        "message": { "type": "string", "minLength": 1 },
        "schema_location": {
          "oneOf": [{ "type": "null" }, { "type": "string" }]
        }
      },
      "required": ["category", "instance_location", "message", "schema_location"]
    },
    "operation_body_v5_prepared": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action_recovery": { "$ref": "#/$defs/action_recovery" },
        "dispatch_id": { "$ref": "#/$defs/dispatch_identity" },
        "operation_id": { "$ref": "#/$defs/operation_identity" },
        "outcome": { "type": "null" },
        "recovery_dispatch": { "$ref": "#/$defs/unsigned" },
        "request_bytes": { "$ref": "#/$defs/hex" },
        "result_bytes": { "type": "null" },
        "result_type": { "type": "null" },
        "retries_left": { "$ref": "#/$defs/nullable_unsigned" },
        "retry_delay_us": { "type": "null" },
        "retry_errors": { "type": "array", "maxItems": 0 },
        "validation_attempt": { "$ref": "#/$defs/unsigned" }
      },
      "required": [
        "action_recovery",
        "dispatch_id",
        "operation_id",
        "outcome",
        "recovery_dispatch",
        "request_bytes",
        "result_bytes",
        "result_type",
        "retries_left",
        "retry_delay_us",
        "retry_errors",
        "validation_attempt"
      ]
    },
    "operation_body_v5_outcome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action_recovery": { "$ref": "#/$defs/action_recovery" },
        "dispatch_id": { "$ref": "#/$defs/dispatch_identity" },
        "operation_id": { "$ref": "#/$defs/operation_identity" },
        "outcome": { "$ref": "#/$defs/hook_outcome" },
        "recovery_dispatch": { "$ref": "#/$defs/unsigned" },
        "request_bytes": { "$ref": "#/$defs/hex" },
        "result_bytes": { "type": "null" },
        "result_type": { "type": "null" },
        "retries_left": { "$ref": "#/$defs/nullable_unsigned" },
        "retry_delay_us": { "type": "null" },
        "retry_errors": { "type": "array", "maxItems": 0 },
        "validation_attempt": { "$ref": "#/$defs/unsigned" }
      },
      "required": [
        "action_recovery",
        "dispatch_id",
        "operation_id",
        "outcome",
        "recovery_dispatch",
        "request_bytes",
        "result_bytes",
        "result_type",
        "retries_left",
        "retry_delay_us",
        "retry_errors",
        "validation_attempt"
      ]
    },
    "operation_body_v5_retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action_recovery": { "$ref": "#/$defs/action_recovery" },
        "dispatch_id": { "$ref": "#/$defs/dispatch_identity" },
        "operation_id": { "$ref": "#/$defs/operation_identity" },
        "outcome": { "$ref": "#/$defs/hook_outcome" },
        "recovery_dispatch": { "$ref": "#/$defs/unsigned" },
        "request_bytes": { "$ref": "#/$defs/hex" },
        "result_bytes": { "type": "null" },
        "result_type": { "type": "null" },
        "retries_left": { "$ref": "#/$defs/nullable_unsigned" },
        "retry_delay_us": { "$ref": "#/$defs/unsigned" },
        "retry_errors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/retry_error" }
        },
        "validation_attempt": { "$ref": "#/$defs/unsigned" }
      },
      "required": [
        "action_recovery",
        "dispatch_id",
        "operation_id",
        "outcome",
        "recovery_dispatch",
        "request_bytes",
        "result_bytes",
        "result_type",
        "retries_left",
        "retry_delay_us",
        "retry_errors",
        "validation_attempt"
      ]
    },
    "operation_body_v5_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action_recovery": { "$ref": "#/$defs/action_recovery" },
        "dispatch_id": { "type": "null" },
        "operation_id": { "$ref": "#/$defs/operation_identity" },
        "outcome": { "type": "null" },
        "recovery_dispatch": { "$ref": "#/$defs/unsigned" },
        "request_bytes": { "type": "null" },
        "result_bytes": { "$ref": "#/$defs/hex" },
        "result_type": { "type": "string", "minLength": 1 },
        "retries_left": { "$ref": "#/$defs/nullable_unsigned" },
        "retry_delay_us": { "type": "null" },
        "retry_errors": { "type": "array", "maxItems": 0 },
        "validation_attempt": { "$ref": "#/$defs/unsigned" }
      },
      "required": [
        "action_recovery",
        "dispatch_id",
        "operation_id",
        "outcome",
        "recovery_dispatch",
        "request_bytes",
        "result_bytes",
        "result_type",
        "retries_left",
        "retry_delay_us",
        "retry_errors",
        "validation_attempt"
      ]
    },
    "logical_evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "budget": { "$ref": "#/$defs/hex" },
        "checkpoint": { "$ref": "#/$defs/hex" },
        "cut": { "type": "string", "minLength": 1 },
        "execution_id": { "$ref": "#/$defs/execution_identity" },
        "format": { "const": "gantry.logical-evidence/v3" },
        "operation": { "$ref": "#/$defs/operation" },
        "sessions": { "$ref": "#/$defs/nullable_hex" },
        "task_id": { "$ref": "#/$defs/task_identity" }
      },
      "required": [
        "budget",
        "checkpoint",
        "cut",
        "execution_id",
        "format",
        "operation",
        "sessions",
        "task_id"
      ]
    },
    "concurrent_evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checkpoint": { "$ref": "#/$defs/hex" },
        "cut": { "type": "string", "minLength": 1 },
        "execution_id": { "$ref": "#/$defs/execution_identity" },
        "format": { "const": "gantry.concurrent-durable-evidence/v4" },
        "task_id": { "$ref": "#/$defs/task_identity" }
      },
      "required": ["checkpoint", "cut", "execution_id", "format", "task_id"]
    },
    "concurrent_ownership_member": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "handle_child": { "$ref": "#/$defs/task_identity" },
        "handle_name": { "type": "string", "minLength": 1 },
        "handle_owner": { "$ref": "#/$defs/task_identity" },
        "task_id": { "$ref": "#/$defs/task_identity" }
      },
      "required": ["handle_child", "handle_name", "handle_owner", "task_id"]
    },
    "concurrent_ownership": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "control_kind": { "enum": ["detach", "join", "joinall"] },
        "disposition": { "enum": ["detached", "joined"] },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/concurrent_ownership_member" }
        },
        "owner_task_id": { "$ref": "#/$defs/task_identity" },
        "site": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/unsigned" }
        },
        "workflow": { "type": "string", "pattern": "^crate::.+$" }
      },
      "required": [
        "control_kind",
        "disposition",
        "members",
        "owner_task_id",
        "site",
        "workflow"
      ]
    },
    "concurrent_evidence_v5": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "checkpoint": { "$ref": "#/$defs/hex" },
            "cancellation": { "type": "null" },
            "cut": { "const": "operation-prepared" },
            "execution_id": { "$ref": "#/$defs/execution_identity" },
            "format": { "const": "gantry.concurrent-durable-evidence/v5" },
            "operation": { "$ref": "#/$defs/operation_body_v5_prepared" },
            "ownership": { "type": "null" },
            "record": { "const": "operation" },
            "task_id": { "$ref": "#/$defs/task_identity" }
          },
          "required": [
            "checkpoint",
            "cancellation",
            "cut",
            "execution_id",
            "format",
            "operation",
            "ownership",
            "record",
            "task_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "checkpoint": { "$ref": "#/$defs/hex" },
            "cancellation": { "type": "null" },
            "cut": { "const": "operation-outcome" },
            "execution_id": { "$ref": "#/$defs/execution_identity" },
            "format": { "const": "gantry.concurrent-durable-evidence/v5" },
            "operation": { "$ref": "#/$defs/operation_body_v5_outcome" },
            "ownership": { "type": "null" },
            "record": { "const": "operation" },
            "task_id": { "$ref": "#/$defs/task_identity" }
          },
          "required": [
            "checkpoint",
            "cancellation",
            "cut",
            "execution_id",
            "format",
            "operation",
            "ownership",
            "record",
            "task_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "checkpoint": { "$ref": "#/$defs/hex" },
            "cancellation": { "type": "null" },
            "cut": { "const": "retry-waiting" },
            "execution_id": { "$ref": "#/$defs/execution_identity" },
            "format": { "const": "gantry.concurrent-durable-evidence/v5" },
            "operation": { "$ref": "#/$defs/operation_body_v5_retry" },
            "ownership": { "type": "null" },
            "record": { "const": "operation" },
            "task_id": { "$ref": "#/$defs/task_identity" }
          },
          "required": [
            "checkpoint",
            "cancellation",
            "cut",
            "execution_id",
            "format",
            "operation",
            "ownership",
            "record",
            "task_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "checkpoint": { "$ref": "#/$defs/hex" },
            "cancellation": { "type": "null" },
            "cut": { "const": "operation-result" },
            "execution_id": { "$ref": "#/$defs/execution_identity" },
            "format": { "const": "gantry.concurrent-durable-evidence/v5" },
            "operation": { "$ref": "#/$defs/operation_body_v5_result" },
            "ownership": { "type": "null" },
            "record": { "const": "operation" },
            "task_id": { "$ref": "#/$defs/task_identity" }
          },
          "required": [
            "checkpoint",
            "cancellation",
            "cut",
            "execution_id",
            "format",
            "operation",
            "ownership",
            "record",
            "task_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "checkpoint": { "$ref": "#/$defs/hex" },
            "cancellation": { "type": "null" },
            "cut": { "enum": ["checkpoint", "task-settlement"] },
            "execution_id": { "$ref": "#/$defs/execution_identity" },
            "format": { "const": "gantry.concurrent-durable-evidence/v5" },
            "operation": { "type": "null" },
            "ownership": { "type": "null" },
            "record": { "const": "submission-resolution" },
            "task_id": { "$ref": "#/$defs/task_identity" }
          },
          "required": [
            "checkpoint",
            "cancellation",
            "cut",
            "execution_id",
            "format",
            "operation",
            "ownership",
            "record",
            "task_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "checkpoint": { "$ref": "#/$defs/hex" },
            "cancellation": { "type": "null" },
            "cut": { "const": "task-ownership" },
            "execution_id": { "$ref": "#/$defs/execution_identity" },
            "format": { "const": "gantry.concurrent-durable-evidence/v5" },
            "operation": { "type": "null" },
            "ownership": { "$ref": "#/$defs/concurrent_ownership" },
            "record": { "const": "ownership" },
            "task_id": { "$ref": "#/$defs/task_identity" }
          },
          "required": [
            "checkpoint",
            "cancellation",
            "cut",
            "execution_id",
            "format",
            "operation",
            "ownership",
            "record",
            "task_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "checkpoint": { "$ref": "#/$defs/hex" },
            "cancellation": { "$ref": "#/$defs/concurrent_cancellation_body" },
            "cut": { "const": "cancellation" },
            "execution_id": { "$ref": "#/$defs/execution_identity" },
            "format": { "const": "gantry.concurrent-durable-evidence/v5" },
            "operation": { "type": "null" },
            "ownership": { "type": "null" },
            "record": { "const": "cancellation" },
            "task_id": { "$ref": "#/$defs/task_identity" }
          },
          "required": [
            "checkpoint",
            "cancellation",
            "cut",
            "execution_id",
            "format",
            "operation",
            "ownership",
            "record",
            "task_id"
          ]
        }
      ]
    },
    "concurrent_recovery_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cancellation": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/concurrent_snapshot_evidence" }
          ]
        },
        "events": {
          "type": "array",
          "items": { "$ref": "#/$defs/concurrent_snapshot_event" }
        },
        "execution_start": { "$ref": "#/$defs/hex" },
        "format": { "const": "gantry.concurrent-recovery-snapshot/v1" },
        "frontier": { "$ref": "#/$defs/unsigned" },
        "frontier_evidence_id": { "$ref": "#/$defs/evidence_identity" },
        "graph": { "$ref": "#/$defs/hex" },
        "graph_evidence_id": { "$ref": "#/$defs/evidence_identity" },
        "graph_kind": {
          "enum": [
            "gantry.concurrent-durable-evidence/v4",
            "gantry.concurrent-durable-evidence/v5"
          ]
        },
        "graph_sequence": { "$ref": "#/$defs/unsigned" },
        "legacy_graphs": {
          "type": "array",
          "items": { "$ref": "#/$defs/concurrent_snapshot_evidence" }
        },
        "operations": {
          "type": "array",
          "items": { "$ref": "#/$defs/concurrent_snapshot_evidence" }
        },
        "ownership_records": {
          "type": "array",
          "items": { "$ref": "#/$defs/concurrent_snapshot_evidence" }
        },
        "retained_evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/concurrent_retained_evidence" }
        },
        "start_evidence_id": { "$ref": "#/$defs/evidence_identity" },
        "submission_resolutions": {
          "type": "array",
          "items": { "$ref": "#/$defs/concurrent_snapshot_evidence" }
        }
      },
      "required": [
        "cancellation",
        "events",
        "execution_start",
        "format",
        "frontier",
        "frontier_evidence_id",
        "graph",
        "graph_evidence_id",
        "graph_kind",
        "graph_sequence",
        "legacy_graphs",
        "operations",
        "ownership_records",
        "retained_evidence",
        "start_evidence_id",
        "submission_resolutions"
      ]
    },
    "concurrent_snapshot_evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "body": { "$ref": "#/$defs/hex" },
        "evidence_id": { "$ref": "#/$defs/evidence_identity" },
        "sequence": { "$ref": "#/$defs/unsigned" }
      },
      "required": ["body", "evidence_id", "sequence"]
    },
    "concurrent_snapshot_event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "body": { "$ref": "#/$defs/hex" },
        "evidence_id": { "$ref": "#/$defs/evidence_identity" },
        "kind": {
          "enum": [
            "gantry.event-delivery-dispatched/v1",
            "gantry.event-delivery-settled/v1",
            "gantry.event-occurrence/v1"
          ]
        },
        "payloads": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "references": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_identity" }
        },
        "sequence": { "$ref": "#/$defs/unsigned" }
      },
      "required": ["body", "evidence_id", "kind", "payloads", "references", "sequence"]
    },
    "concurrent_retained_evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence_id": { "$ref": "#/$defs/evidence_identity" },
        "sequence": { "$ref": "#/$defs/unsigned" }
      },
      "required": ["evidence_id", "sequence"]
    },
    "concurrent_cancellation": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/concurrent_cancellation_body" }
      ]
    },
    "concurrent_cancellation_body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "causal_identity": { "$ref": "#/$defs/causal_identity" },
        "category": { "enum": ["caller", "deadline", "runtime", "shutdown"] },
        "message": { "$ref": "#/$defs/nullable_string" }
      },
      "required": ["causal_identity", "category", "message"]
    },
    "causal_identity": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "identity": { "$ref": "#/$defs/operation_identity" },
            "kind": { "const": "operation" }
          },
          "required": ["identity", "kind"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "identity": { "$ref": "#/$defs/task_identity" },
            "kind": { "const": "task" }
          },
          "required": ["identity", "kind"]
        }
      ]
    },
    "cancellation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "causal_identity": { "$ref": "#/$defs/causal_identity" },
        "category": { "enum": ["caller", "deadline", "runtime", "shutdown"] },
        "format": { "const": "gantry.cancellation/v3" },
        "message": { "$ref": "#/$defs/nullable_string" },
        "state": { "$ref": "#/$defs/hex" }
      },
      "required": ["causal_identity", "category", "format", "message", "state"]
    },
    "execution_start": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "execution_id": { "$ref": "#/$defs/execution_identity" },
        "format": { "const": "gantry.execution-start/v3" },
        "metadata": { "$ref": "#/$defs/hex" },
        "program": { "$ref": "#/$defs/hex" },
        "state": { "$ref": "#/$defs/hex" },
        "task_id": { "$ref": "#/$defs/task_identity" }
      },
      "required": ["execution_id", "format", "metadata", "program", "state", "task_id"]
    },
    "execution_state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action_mapping_revision": { "$ref": "#/$defs/nullable_string" },
        "agent_mapping_revision": { "$ref": "#/$defs/nullable_string" },
        "execution_id": { "$ref": "#/$defs/execution_identity" },
        "format": { "const": "gantry.execution-state/v1" },
        "mutable_policy": {}
      },
      "required": [
        "action_mapping_revision",
        "agent_mapping_revision",
        "execution_id",
        "format",
        "mutable_policy"
      ]
    },
    "recovery_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "execution_start": { "$ref": "#/$defs/hex" },
        "execution_state": { "$ref": "#/$defs/nullable_hex" },
        "format": { "const": "gantry.recovery-snapshot/v3" },
        "state": { "$ref": "#/$defs/hex" }
      },
      "required": ["execution_start", "execution_state", "format", "state"]
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "major": { "const": 1 },
        "minor": { "const": 0 }
      },
      "required": ["major", "minor"]
    },
    "source": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "end": { "$ref": "#/$defs/unsigned" },
            "path": { "type": "string", "minLength": 1 },
            "start": { "$ref": "#/$defs/unsigned" }
          },
          "required": ["end", "path", "start"]
        }
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "activity_id": { "$ref": "#/$defs/identity" },
        "causal_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/identity" },
          "uniqueItems": true
        },
        "event_id": { "$ref": "#/$defs/event_identity" },
        "execution_id": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/execution_identity" }
          ]
        },
        "kind": { "type": "string", "minLength": 1 },
        "layer": { "enum": ["logical", "physical"] },
        "operation_id": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/identity" }
          ]
        },
        "payload": { "$ref": "#/$defs/hex" },
        "per_task_sequence": { "$ref": "#/$defs/nullable_unsigned" },
        "protected_references": { "type": "array" },
        "source": { "$ref": "#/$defs/source" },
        "task_id": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/task_identity" }
          ]
        },
        "timestamp": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/version" }
      },
      "required": [
        "activity_id",
        "causal_ids",
        "event_id",
        "execution_id",
        "kind",
        "layer",
        "operation_id",
        "payload",
        "per_task_sequence",
        "protected_references",
        "source",
        "task_id",
        "timestamp",
        "version"
      ]
    },
    "event_occurrence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "causal_evidence_id": { "$ref": "#/$defs/evidence_identity" },
        "event": { "$ref": "#/$defs/event" },
        "format": { "const": "gantry.event-occurrence/v1" },
        "plan": { "type": "array" }
      },
      "required": ["causal_evidence_id", "event", "format", "plan"]
    },
    "event_dispatched": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attempt_id": { "$ref": "#/$defs/attempt_identity" },
        "event_id": { "$ref": "#/$defs/event_identity" },
        "format": { "const": "gantry.event-delivery-dispatched/v1" },
        "retry_number": { "$ref": "#/$defs/unsigned" },
        "sink_id": { "type": "string", "minLength": 1 }
      },
      "required": ["attempt_id", "event_id", "format", "retry_number", "sink_id"]
    },
    "event_settled": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attempt_id": { "$ref": "#/$defs/attempt_identity" },
        "event_id": { "$ref": "#/$defs/event_identity" },
        "format": { "const": "gantry.event-delivery-settled/v1" },
        "outcome": { "type": "string", "minLength": 1 },
        "remaining_retries": { "$ref": "#/$defs/unsigned" },
        "retry_number": { "$ref": "#/$defs/unsigned" },
        "selected_delay_us": { "$ref": "#/$defs/nullable_unsigned" },
        "sink_id": { "type": "string", "minLength": 1 }
      },
      "required": [
        "attempt_id",
        "event_id",
        "format",
        "outcome",
        "remaining_retries",
        "retry_number",
        "selected_delay_us",
        "sink_id"
      ]
    }
  }
}
